# P6 preparation only: all SID/OIDC switches remain OFF.
# This file is a review template, not a live .env or a deployment command.
# Replace every <...> after signed protocol confirmation; never commit secrets.
OIDC_AUTH_ENABLE=false
SOURCEID_ENABLE=false
SOURCEID_LOGOUT_ENABLE=false
SOURCEID_CONTRACT_CONFIRMED=false

OIDC_AUTH_PROVIDER_DISPLAY_NAME=企业SID
OIDC_AUTH_CLIENT_ID=knowhub
OIDC_AUTH_CLIENT_SECRET=<secure-deployment-injection>
# Base https://sid.ruijie.com.cn is known; it is NOT the verified issuer.
OIDC_AUTH_ISSUER_URL=<confirmed-exact-issuer>
# If no Discovery is offered, leave this empty and supply every required endpoint.
OIDC_AUTH_DISCOVERY_URL=<confirmed-discovery-or-empty>
OIDC_AUTH_AUTHORIZATION_ENDPOINT=<confirmed-authorization-url>
OIDC_AUTH_TOKEN_ENDPOINT=<confirmed-token-url>
OIDC_AUTH_USER_INFO_ENDPOINT=<confirmed-profile-url-or-empty-if-not-required>
OIDC_AUTH_JWKS_URI=<confirmed-jwks-url>
OIDC_AUTH_SCOPES=openid
OIDC_AUTH_REDIRECT_URI=http://knowhub.ruijie.com.cn/api/v1/auth/oidc/callback
# Only client_secret_post or client_secret_basic; Token always urlencoded POST.
OIDC_AUTH_CLIENT_AUTH_METHOD=<confirmed-client_secret_post-or-client_secret_basic>
# Only bearer_get, form_post (urlencoded), multipart_post; no token in URL.
OIDC_AUTH_USER_INFO_TRANSPORT=<confirmed-bearer_get-or-form_post-or-multipart_post>
# false until support is confirmed; enabling requires controlled test approval.
OIDC_AUTH_PKCE_ENABLE=false

# id_token or userinfo; all business fields must come from the selected source.
SOURCEID_CLAIMS_SOURCE=<confirmed-id_token-or-userinfo>
SOURCEID_EMPLOYEE_CLAIM=<confirmed-natural-person-employee-dot-path>
SOURCEID_STATUS_CLAIM=<confirmed-employee-status-dot-path>
SOURCEID_ALLOWED_STATUS=<confirmed-exact-string-or-boolean-status>
# Must be proven identical to that login's backchannel SessionIndex.
SOURCEID_SESSION_CLAIM=<confirmed-session-dot-path>
# xml or deflate-base64 (base64 + RAW DEFLATE); no autodetection.
SOURCEID_LOGOUT_ENCODING=<confirmed-xml-or-deflate-base64>
# Application direct socket peer, usually final ingress proxy. Not forwarded IP.
SOURCEID_LOGOUT_CIDRS=<confirmed-final-ingress-peer-cidrs>
# INTERNAL gateway credential; not a presumed native SourceID header/secret.
SOURCEID_LOGOUT_SECRET=<secure-random-internal-secret-at-least-32-bytes>

# Review existing deployed whitelist/JWT policy before injecting any overrides.
# Preserve existing approved whitelist entries; do not broaden network ranges.
# System settings may override environment SSRF whitelist, so verify effective policy.
SSRF_WHITELIST=<existing-approved-hosts-plus-confirmed-private-sid-endpoint-hosts-if-needed>
JWT_SECRET=<existing-shared-strong-jwt-secret-through-secure-injection>
# Enrollment TOOL only, never required by the application; isolated test DB only.
# Do not pass DSN as an argument or print it in review output.
# SOURCEID_ENROLL_DSN=<secure-isolated-test-database-dsn>

# Registered logout URI (not an application env variable):
# http://knowhub.ruijie.com.cn/api/v1/auth/oidc/backchannel-logout
# No _FILE secret loading exists in this code; use restricted deployment injection.
# No real credential, endpoint guess or enabling switch belongs in this template.
