# Isolated acceptance template, not an installed production configuration.
# Replace these placeholders with trusted operator values, never HTTP input.
worker_processes 1;
events { worker_connections 128; }
http {
  log_format safe '$time_iso8601 $request_method $uri $status $body_bytes_sent';
  access_log /dev/stdout safe;
  error_log /dev/stderr warn;
  server {
    listen 127.0.0.1:__LISTEN_PORT__;
    server_name localhost;
    client_max_body_size 1m;
    location = /api/v1/mcp/personal {
      if ($request_method !~ ^(GET|POST|DELETE)$) { return 405; }
      proxy_pass http://127.0.0.1:__APP_PORT__;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $http_host;
      proxy_set_header Authorization $http_authorization;
      proxy_buffering off;
      proxy_cache off;
      proxy_read_timeout 120s;
      proxy_send_timeout 120s;
      # Do not replay MCP POSTs against another upstream on failures.
      proxy_next_upstream off;
    }
    location / { return 403; }
  }
}
