# P1 only. Render __ROOT__ to the dedicated test directory. No production Key/cert.
worker_processes 1;
pid /tmp/knowhub-isolated-p1-nginx.pid;
error_log /dev/null crit;
events { worker_connections 128; }
http {
    server_tokens off;
    map $request_uri $exact_mcp {
        default 0;
        "/api/v1/mcp/personal" 1;
    }
    map $http_host $approved_host {
        default 0;
        "localhost:8443" 1;
        "knowhub.ruijie.com.cn:8443" 1;
    }
    map "$request_method:$http_content_type" $json_mcp {
        default 0;
        "~*^POST:application/json([ ]*;[ ]*charset=utf-8)?$" 1;
        "GET:" 1;
        "DELETE:" 1;
        "GET:application/json" 1;
        "DELETE:application/json" 1;
    }
    map $http_content_encoding $plain_mcp {
        default 0;
        "" 1;
        "identity" 1;
    }
    log_format metadata '$time_iso8601 $status $body_bytes_sent $request_time';
    access_log __ROOT__/logs/nginx-access.log metadata;
    limit_req_zone $binary_remote_addr zone=p1_req:1m rate=5r/s;
    limit_conn_zone $binary_remote_addr zone=p1_conn:1m;
    limit_conn_zone $server_name zone=p1_total:1m;
    # Negative TLS fixture: same trusted test CA, deliberately expired leaf.
    server {
        listen 127.0.0.1:18443 ssl;
        server_name localhost;
        ssl_certificate __ROOT__/private/test-expired.pem;
        ssl_certificate_key __ROOT__/private/test-key.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        return 204;
    }
    server {
        listen 127.0.0.1:8443 ssl;
        server_name localhost knowhub.ruijie.com.cn;
        ssl_certificate __ROOT__/private/test-fullchain.pem;
        ssl_certificate_key __ROOT__/private/test-key.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_tickets off;
        ssl_early_data off;
        client_max_body_size 1m;
        client_header_timeout 10s;
        client_body_timeout 15s;
        keepalive_timeout 15s;
        if ($approved_host = 0) { return 421; }
        location = /api/v1/mcp/personal {
            if ($exact_mcp = 0) { return 404; }
            if ($request_method !~ ^(GET|POST|DELETE)$) { return 405; }
            if ($json_mcp = 0) { return 415; }
            if ($plain_mcp = 0) { return 415; }
            allow 127.0.0.1;
            deny all;
            limit_req zone=p1_req burst=40 nodelay;
            limit_req_status 429;
            limit_conn p1_conn 8;
            # Reserve at least half of the PersonalServer's eight slots for
            # the unchanged internal HTTP entry, across all isolation clients.
            limit_conn p1_total 4;
            limit_conn_status 429;
            proxy_pass http://127.0.0.1:18644;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header Connection "";
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Environment "";
            proxy_set_header X-Isolated "";
            proxy_next_upstream off;
            proxy_cache off;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_connect_timeout 5s;
            proxy_send_timeout 30s;
            proxy_read_timeout 35s;
            add_header Cache-Control "no-store" always;
            add_header X-Accel-Buffering "no" always;
        }
        location / { return 404; }
    }
}
